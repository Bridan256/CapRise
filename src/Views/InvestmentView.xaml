<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapRise.Views.InvestmentView"
             Title="Investment View">

    <StackLayout Padding="10">
        <Label Text="Investment Management"
               FontSize="24"
               HorizontalOptions="Center" />

        <ListView x:Name="InvestmentListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Orientation="Horizontal" Padding="5">
                            <Label Text="{Binding Name}" FontSize="18" />
                            <Label Text="{Binding Amount, StringFormat='{}{0:C}'}" FontSize="18" HorizontalOptions="EndAndExpand" />
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Text="Add Investment"
                Command="{Binding AddInvestmentCommand}" />
    </StackLayout>
</ContentPage>