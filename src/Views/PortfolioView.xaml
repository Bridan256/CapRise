<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CapRise.Views.PortfolioView"
             Title="Portfolio">

    <StackLayout Padding="20">
        <Label Text="Portfolio Overview"
               FontSize="24"
               HorizontalOptions="Center" />

        <ListView x:Name="PortfolioListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Orientation="Horizontal" Padding="10">
                            <Label Text="{Binding Name}" FontSize="18" />
                            <Label Text="{Binding Amount, StringFormat='{}{0:C}'}" FontSize="18" HorizontalOptions="EndAndExpand" />
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Text="Refresh Portfolio"
                Command="{Binding RefreshPortfolioCommand}" />
    </StackLayout>
</ContentPage>